+        throw new Error(
+          `Connection "${connection.connectionName}" mapped upstream tool ${JSON.stringify(upstreamName)} to an invalid empty model name.`,
+        );
+      if (!pattern.test(modelName))
+        throw new Error(
+          `Connection "${connection.connectionName}" mapped upstream tool ${JSON.stringify(upstreamName)} to ${JSON.stringify(modelName)}, which must match ${String(pattern)}.`,
+        );
+      return { modelName, upstreamName };
+    })
