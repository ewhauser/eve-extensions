+export function projectConnectionToolNames(
+  connection: ResolvedConnectionDefinition,
+  names: readonly string[],
+): Map<string, string> {
+  const pattern = /^[a-zA-Z0-9_-]{1,64}$/;
+  const mapped = names
+    .map((upstreamName) => {
+      const modelName = connection.toolName?.toModelName(upstreamName) ?? upstreamName;
+      if (typeof modelName !== "string" || modelName.length === 0)
+        throw new Error(
+          `Connection "${connection.connectionName}" mapped upstream tool ${JSON.stringify(upstreamName)} to an invalid empty model name.`,
+        );
+      const qualified = `${connection.connectionName}__${modelName}`;
+      if (!pattern.test(qualified))
+        throw new Error(
+          `Connection "${connection.connectionName}" mapped upstream tool ${JSON.stringify(upstreamName)} to ${JSON.stringify(qualified)}, which must match ${String(pattern)}.`,
+        );
+      return { modelName, upstreamName };
+    })
+    .sort((a, b) => a.upstreamName.localeCompare(b.upstreamName));
+  const groups = new Map<string, string[]>();
+  for (const { modelName, upstreamName } of mapped) {
+    const group = groups.get(modelName) ?? [];
+    group.push(upstreamName);
+    groups.set(modelName, group);
+  }
+  const collisions = [...groups]
+    .filter(([, group]) => group.length > 1)
+    .sort(([a], [b]) => a.localeCompare(b));
+  if (collisions.length)
+    throw new Error(
+      `Connection "${connection.connectionName}" tool-name mapping collision: ${collisions.map(([name, group]) => `${JSON.stringify(name)} <= ${group.map((name) => JSON.stringify(name)).join(", ")}`).join("; ")}.`,
+    );
+  return new Map(mapped.map(({ modelName, upstreamName }) => [upstreamName, modelName]));
+}
+
+function sameToolMetadata(a: ConnectionToolMetadata, b: ConnectionToolMetadata): boolean {
