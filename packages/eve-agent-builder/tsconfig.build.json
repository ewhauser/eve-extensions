{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": [
    "index.ts",
    "extension/**/*.ts",
    "mounts/**/*.ts",
    "runtime/**/*.ts",
    "src/**/*.ts",
    "stores/**/*.ts",
    "testing/**/*.ts"
  ],
  "exclude": ["test/**/*.ts"]
}
