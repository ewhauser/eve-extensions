{
  "name": "eve-agent-builder",
  "version": "0.0.0",
  "description": "Experimental owner-scoped saved-agent control plane and isolated direct runner for Eve.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/extension/lib/public.d.ts",
      "import": "./dist/extension/lib/public.mjs",
      "default": "./dist/extension/lib/public.mjs"
    },
    "./extension": {
      "types": "./dist/extension/extension.d.ts",
      "import": "./dist/extension/extension.mjs",
      "default": "./dist/extension/extension.mjs"
    },
    "./bootstrap": {
      "types": "./dist/extension/lib/bootstrap.d.ts",
      "default": "./dist/extension/lib/bootstrap.mjs"
    },
    "./capabilities": {
      "types": "./dist/extension/lib/capabilities.d.ts",
      "default": "./dist/extension/lib/capabilities.mjs"
    },
    "./discovery": {
      "types": "./dist/extension/lib/discovery.d.ts",
      "default": "./dist/extension/lib/discovery.mjs"
    },
    "./domain": {
      "types": "./dist/extension/lib/domain.d.ts",
      "default": "./dist/extension/lib/domain.mjs"
    },
    "./service": {
      "types": "./dist/extension/lib/service.d.ts",
      "default": "./dist/extension/lib/service.mjs"
    },
    "./roles": {
      "types": "./dist/extension/lib/roles.d.ts",
      "default": "./dist/extension/lib/roles.mjs"
    },
    "./store": {
      "types": "./dist/extension/lib/store.d.ts",
      "default": "./dist/extension/lib/store.mjs"
    },
    "./stores/memory": {
      "types": "./dist/extension/lib/stores/memory.d.ts",
      "default": "./dist/extension/lib/stores/memory.mjs"
    },
    "./testing/store-conformance": {
      "types": "./dist/extension/lib/testing/store-conformance.d.ts",
      "default": "./dist/extension/lib/testing/store-conformance.mjs"
    },
    "./testing/bootstrap-conformance": {
      "types": "./dist/extension/lib/testing/bootstrap-conformance.d.ts",
      "default": "./dist/extension/lib/testing/bootstrap-conformance.mjs"
    },
    "./runtime/*": {
      "types": "./dist/extension/lib/runtime/*.d.ts",
      "default": "./dist/extension/lib/runtime/*.mjs"
    },
    "./mounts/*": {
      "types": "./dist/extension/lib/mounts/*.d.ts",
      "default": "./dist/extension/lib/mounts/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "restore:exports": "node scripts/restore-hybrid-exports.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eve": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eve": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewhauser/eve-extensions.git",
    "directory": "packages/eve-agent-builder"
  },
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  },
  "bugs": {
    "url": "https://github.com/ewhauser/eve-extensions/issues"
  },
  "homepage": "https://github.com/ewhauser/eve-extensions/tree/main/packages/eve-agent-builder#readme"
}
