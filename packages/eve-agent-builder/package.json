{
  "name": "eve-agent-builder",
  "version": "0.0.0",
  "description": "Experimental identity, versioned domain, and durable store contracts for Eve saved agents.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/src/domain.d.ts",
      "import": "./dist/src/domain.js",
      "default": "./dist/src/domain.js"
    },
    "./service": {
      "types": "./dist/src/service.d.ts",
      "import": "./dist/src/service.js",
      "default": "./dist/src/service.js"
    },
    "./store": {
      "types": "./dist/src/store.d.ts",
      "import": "./dist/src/store.js",
      "default": "./dist/src/store.js"
    },
    "./stores/memory": {
      "types": "./dist/stores/memory.d.ts",
      "import": "./dist/stores/memory.js",
      "default": "./dist/stores/memory.js"
    },
    "./testing/store-conformance": {
      "types": "./dist/testing/store-conformance.d.ts",
      "import": "./dist/testing/store-conformance.js",
      "default": "./dist/testing/store-conformance.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eve": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eve": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewhauser/eve-extensions.git",
    "directory": "packages/eve-agent-builder"
  },
  "bugs": {
    "url": "https://github.com/ewhauser/eve-extensions/issues"
  },
  "homepage": "https://github.com/ewhauser/eve-extensions/tree/main/packages/eve-agent-builder#readme"
}
