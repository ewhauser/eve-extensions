{
  "name": "eve-aws-lambda-microvms",
  "version": "0.5.1",
  "description": "An Eve sandbox backend for durable AWS Lambda MicroVMs.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/generate-controller-assets.mjs && pnpm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:aws": "pnpm run build && tsx e2e/runner.ts run",
    "test:aws:cleanup": "tsx e2e/runner.ts cleanup",
    "test:aws:plan": "tsx e2e/runner.ts plan",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-lambda-microvms": "catalog:",
    "@aws-sdk/client-s3": "3.1106.0",
    "@aws-sdk/s3-request-presigner": "3.1106.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1073.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1073.0",
    "@aws-sdk/client-sts": "3.1073.0",
    "@types/node": "catalog:",
    "ai": "catalog:",
    "eve": "catalog:",
    "tsx": "^4.23.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eve": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewhauser/eve-extensions.git",
    "directory": "packages/eve-aws-lambda-microvms"
  },
  "bugs": {
    "url": "https://github.com/ewhauser/eve-extensions/issues"
  },
  "homepage": "https://github.com/ewhauser/eve-extensions/tree/main/packages/eve-aws-lambda-microvms#readme"
}
