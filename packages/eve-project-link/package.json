{
  "name": "eve-project-link",
  "version": "0.4.0",
  "description": "Channel-scoped project context for Eve using the Notion, Linear, or custom tools already mounted by the host agent.",
  "license": "MIT",
  "type": "module",
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  },
  "files": [
    "dist",
    "README.md",
    "PRESETS.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./notion": {
      "types": "./dist/extension/presets/notion.d.ts",
      "default": "./dist/extension/presets/notion.mjs"
    },
    "./linear": {
      "types": "./dist/extension/presets/linear.d.ts",
      "default": "./dist/extension/presets/linear.mjs"
    },
    "./custom": {
      "types": "./dist/extension/presets/custom.d.ts",
      "default": "./dist/extension/presets/custom.mjs"
    },
    "./presets": {
      "types": "./dist/extension/presets/index.d.ts",
      "default": "./dist/extension/presets/index.mjs"
    },
    "./stores/memory": {
      "types": "./dist/extension/stores/memory.d.ts",
      "default": "./dist/extension/stores/memory.mjs"
    },
    "./types": {
      "types": "./dist/extension/lib/types.d.ts",
      "default": "./dist/extension/lib/types.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    }
  },
  "scripts": {
    "build": "eve extension build",
    "prepare": "eve extension build",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eve": "0.38.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "eve": "0.38.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewhauser/eve-extensions.git",
    "directory": "packages/eve-project-link"
  },
  "bugs": {
    "url": "https://github.com/ewhauser/eve-extensions/issues"
  },
  "homepage": "https://github.com/ewhauser/eve-extensions/tree/main/packages/eve-project-link#readme"
}
