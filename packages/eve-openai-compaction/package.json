{
  "name": "eve-openai-compaction",
  "version": "0.1.0",
  "description": "A Codex-style checkpoint compaction strategy for Eve agents.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "patches",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@ai-sdk/openai": "catalog:",
    "@types/node": "catalog:",
    "ai": "catalog:",
    "eve": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@ai-sdk/openai": "catalog:",
    "ai": "catalog:",
    "eve": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewhauser/eve-extensions.git",
    "directory": "packages/eve-openai-compaction"
  },
  "bugs": {
    "url": "https://github.com/ewhauser/eve-extensions/issues"
  },
  "homepage": "https://github.com/ewhauser/eve-extensions/tree/main/packages/eve-openai-compaction#readme"
}
