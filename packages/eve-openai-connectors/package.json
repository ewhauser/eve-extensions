{
  "name": "eve-openai-connectors",
  "version": "0.5.0",
  "description": "An Eve extension that exposes a ChatGPT Enterprise user's authorized connectors as dynamically discovered tools.",
  "license": "MIT",
  "type": "module",
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  },
  "files": [
    "dist",
    "patches",
    "scripts/probe.mjs",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    },
    "./connectors": {
      "types": "./dist/extension/lib/connectors.d.ts",
      "default": "./dist/extension/lib/connectors.mjs"
    }
  },
  "scripts": {
    "build": "eve extension build",
    "prepare": "eve extension build",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.30",
    "@ai-sdk/openai": "^4.0.30",
    "@types/node": "^24.0.0",
    "ai": "^7.0.38",
    "eve": "0.31.3",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "eve": "0.31.3"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewhauser/eve-extensions.git",
    "directory": "packages/eve-openai-connectors"
  },
  "bugs": {
    "url": "https://github.com/ewhauser/eve-extensions/issues"
  },
  "homepage": "https://github.com/ewhauser/eve-extensions/tree/main/packages/eve-openai-connectors#readme"
}
